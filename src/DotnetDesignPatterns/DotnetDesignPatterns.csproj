<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>DotnetDesignPatterns</RootNamespace>
    <!-- This project is a reference implementation meant to be read and run from the
         repository, not a library distributed on NuGet. Set IsPackable back to true and
         add a PackageId if that ever changes. -->
    <IsPackable>false</IsPackable>
    <Authors>Francesco Del Re</Authors>
    <Description>GoF Design Patterns implemented in .NET C#</Description>
    <RepositoryUrl>https://github.com/engineering87/dotnet-design-patterns</RepositoryUrl>
    <PackageProjectUrl>https://github.com/engineering87/dotnet-design-patterns</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

</Project>
